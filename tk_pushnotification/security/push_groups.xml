<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_groups_privilege_push" model="res.groups.privilege">
        <field name="name">Push Notifications</field>
        <field name="category_id" ref="base.module_category_administration"/>
    </record>

    <record id="group_push_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="comment">Configure push providers, see every registered device, and send and monitor notifications. Grants access to Firebase service account credentials.</field>
        <field name="privilege_id" ref="res_groups_privilege_push"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="implied_by_ids" eval="[Command.link(ref('base.group_system'))]"/>
    </record>

</odoo>
